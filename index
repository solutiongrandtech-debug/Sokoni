function palette(url){return new Promise(res=>{const im=new Image();im.onerror=()=>res(null);im.onload=()=>{try{const c=document.createElement('canvas');c.width=c.height=48;const x=c.getContext('2d');x.drawImage(im,0,0,48,48);const d=x.getImageData(0,0,48,48).data,m={};
for(let i=0;i<d.length;i+=4){const r=d[i],g=d[i+1],b=d[i+2],mx=Math.max(r,g,b),mn=Math.min(r,g,b),sat=mx?(mx-mn)/mx:0,l=(mx+mn)/510;if(sat<.28||l>.92||l<.12)continue;const k=(r>>5)+','+(g>>5)+','+(b>>5),e=m[k]||(m[k]={n:0,r:0,g:0,b:0});e.n++;e.r+=r;e.g+=g;e.b+=b}
const L=Object.values(m).sort((a,b)=>b.n-a.n).map(e=>[e.r/e.n,e.g/e.n,e.b/e.n].map(Math.round)),hex=a=>'#'+a.map(v=>v.toString(16).padStart(2,'0')).join(''),pr=L[0]||[47,95,216],dist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1],a[2]-b[2]),s2=L.find(v=>dist(v,pr)>90)||pr.map(v=>Math.round(v*.6));res({primary:hex(pr),secondary:hex(s2)})}catch(e){res(null)}};im.src=url})}
